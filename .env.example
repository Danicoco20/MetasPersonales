# Base de datos
DB_URL=jdbc:mysql://localhost:3306/BD_Metas_personales?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=usuario_mysql
DB_PASSWORD=contraseña_mysql

# Google reCAPTCHA v2 checkbox ("No soy un robot")
RECAPTCHA_SITE_KEY=clave_publica
RECAPTCHA_SECRET_KEY=clave_secreta

# Google Identity Services (OAuth / OpenID Connect)
GOOGLE_CLIENT_ID=cliente.apps.googleusercontent.com

# URL pública base (recomendado en producción, siempre HTTPS)
APP_BASE_URL=https://tudominio.com

# SMTP STARTTLS (587), por ejemplo proveedor de correo transaccional
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASSWORD=contraseña_smtp
SMTP_FROM=notificaciones@example.com

